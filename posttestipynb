        "class MesinPengering:\n",
        "    \"\"\"\n",
        "    Merepresentasikan mesin pengering pada sistem agroindustri.\n",
        "    Atribut suhu_maksimum_celcius dan kapasitas_muat_kg merupakan\n",
        "    batasan fisik nyata yang tidak boleh dilanggar saat operasi.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, nama_mesin, suhu_maksimum_celcius,\n",
        "                 kapasitas_muat_kg):\n",
        "        self.nama_mesin = nama_mesin                          # PUBLIC\n",
        "        self.__suhu_maksimum_celcius = suhu_maksimum_celcius  # PRIVATE\n",
        "        self.__kapasitas_muat_kg = kapasitas_muat_kg          # PRIVATE\n",
        "        # Atribut state operasional\n",
        "        self.__suhu_saat_ini = 0.0\n",
        "        self.__muatan_saat_ini_kg = 0.0\n",
        "        self.__sedang_beroperasi = False\n",
        "\n",
        "    def muat_bahan(self, berat_kg):\n",
        "        \"\"\"Memuat bahan ke mesin, memvalidasi batas kapasitas fisik.\"\"\"\n",
        "        if self.__muatan_saat_ini_kg + berat_kg > self.__kapasitas_muat_kg:\n",
        "            print(f\"Error: kapasitas {self.nama_mesin} terlampaui \"\n",
        "                  f\"({self.__muatan_saat_ini_kg + berat_kg:.1f} kg > \"\n",
        "                  f\"{self.__kapasitas_muat_kg:.1f} kg).\")\n",
        "            return False\n",
        "        self.__muatan_saat_ini_kg += berat_kg\n",
        "        print(f\"{berat_kg:.1f} kg bahan dimuat ke {self.nama_mesin}. \"\n",
        "              f\"Total muatan: {self.__muatan_saat_ini_kg:.1f} kg.\")\n",
        "        return True\n",
        "\n",
        "    def mulai_pengeringan(self, suhu_operasi):\n",
        "        \"\"\"Memulai proses pengeringan, memvalidasi batas suhu maksimum.\"\"\"\n",
        "        if suhu_operasi > self.__suhu_maksimum_celcius:\n",
        "            print(f\"Error: suhu operasi {suhu_operasi}°C melebihi batas \"\n",
        "                  f\"aman {self.__suhu_maksimum_celcius}°C untuk \"\n",
        "                  f\"{self.nama_mesin}.\")\n",
        "            return False\n",
        "        self.__suhu_saat_ini = suhu_operasi\n",
        "        self.__sedang_beroperasi = True\n",
        "        print(f\"{self.nama_mesin} mulai beroperasi pada suhu \"\n",
        "              f\"{suhu_operasi}°C.\")\n",
        "        return True\n",
        "\n",
        "    def status(self):\n",
        "        \"\"\"Mengembalikan ringkasan kondisi (state) mesin saat ini.\"\"\"\n",
        "        kondisi = \"beroperasi\" if self.__sedang_beroperasi else \"berhenti\"\n",
        "        return (f\"{self.nama_mesin} [{kondisi}] - suhu: \"\n",
        "                f\"{self.__suhu_saat_ini}°C, \"\n",
        "                f\"muatan: \"\n",
        "                f\"{self.__muatan_saat_ini_kg:.1f}/{self.__kapasitas_muat_kg:.1f} kg\")\n",
        "\n",
        "# Penggunaan\n",
        "pengering_a = MesinPengering(\"Pengering Gabah A\",\n",
        "                             suhu_maksimum_celcius=60, kapasitas_muat_kg=500)\n",
        "pengering_a.muat_bahan(450)\n",
        "pengering_a.mulai_pengeringan(55)  # Diterima, di bawah batas maksimum\n",
        "pengering_a.mulai_pengeringan(75)  # Ditolak, melampaui suhu maksimum\n",
        "print(pengering_a.status())"
